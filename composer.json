{
  "name": "jatnnik/edric",
  "description": "A lightweight PSR-compatible PHP router with a Laravel-inspired API.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Jatnnik\\Edric\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Jatnnik\\Edric\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Jannik Baranczyk",
      "homepage": "https://jatnnik.dev"
    }
  ],
  "require": {
    "php": "^8.2",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/http-server-handler": "^1.0"
  },
  "require-dev": {
    "laravel/pint": "^1.31",
    "pestphp/pest": "^5.1",
    "phpstan/phpstan": "^2.2",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1"
  },
  "scripts": {
    "analyse": "./vendor/bin/phpstan",
    "fmt": "./vendor/bin/pint",
    "test": "./vendor/bin/pest",
    "qa": [
      "composer fmt",
      "composer analyse",
      "composer test"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
